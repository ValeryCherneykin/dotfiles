#!/bin/bash
# Photo mode alt - matrix layout for screenshots

SESSION_NAME="photo"

tmux kill-session -t "$SESSION_NAME" 2>/dev/null

tmux new-session -d -s "$SESSION_NAME" -n "main"
tmux send-keys -t "$SESSION_NAME:main" "fastfetch" C-m

tmux split-window -h -t "$SESSION_NAME:main"
tmux send-keys -t "$SESSION_NAME:main.1" "cmatrix -C cyan" C-m

tmux split-window -h -t "$SESSION_NAME:main.1"
tmux send-keys -t "$SESSION_NAME:main.2" "cd ~/.config/nvim && nvim init.lua" C-m

tmux resize-pane -t "$SESSION_NAME:main.0" -x 45
tmux resize-pane -t "$SESSION_NAME:main.1" -x 35

tmux select-pane -t "$SESSION_NAME:main.0"

if [[ -z $TMUX ]]; then
    tmux attach-session -t "$SESSION_NAME"
else
    tmux switch-client -t "$SESSION_NAME"
fi
